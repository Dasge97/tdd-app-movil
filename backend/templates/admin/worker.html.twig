{% extends 'admin/base.html.twig' %}

{% block title %}Worker Config — TDD Admin{% endblock %}

{% block content %}
<h2 class="mb-4">Worker Configuration</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><strong>Settings</strong></div>
            <div class="card-body">
                <form method="POST" action="/admin/worker/config">
                    <div class="mb-3">
                        <label class="form-label">Cron Schedule</label>
                        <input type="text" class="form-control" name="schedule" value="{{ config.schedule }}" placeholder="0 7 * * *">
                        <div class="form-text">Standard cron expression</div>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" name="enabled" id="enabled" {% if config.enabled %}checked{% endif %}>
                        <label class="form-check-label" for="enabled">Worker Enabled</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Dedup Days</label>
                            <input type="number" class="form-control" name="dedupDays" value="{{ config.dedupDays }}" min="1" max="90">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Rotation Limit Days</label>
                            <input type="number" class="form-control" name="rotationLimitDays" value="{{ config.rotationLimitDays }}" min="1" max="30">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Target Debates</label>
                            <input type="number" class="form-control" name="targetDebates" value="{{ config.targetDebates }}" min="1" max="20">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">OpenCode Model</label>
                            <input type="text" class="form-control" name="opencodeModel" value="{{ config.opencodeModel }}">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">OpenCode Provider</label>
                            <input type="text" class="form-control" name="opencodeProvider" value="{{ config.opencodeProvider }}">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Configuration</button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><strong>Manual Trigger</strong></div>
            <div class="card-body">
                <p class="text-muted">Queue an immediate worker execution on next poll.</p>
                <form method="POST" action="/admin/worker/trigger">
                    <button type="submit" class="btn btn-warning"
                        onclick="return confirm('Trigger worker run?')">
                        Trigger Worker Now
                    </button>
                </form>
                {% if config.triggerPending %}
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>Trigger pending</strong> — worker will run on next poll.
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><strong>Run History</strong></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Status</th>
                                <th>Debates</th>
                                <th>Started</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for run in runs %}
                            <tr>
                                <td><code title="{{ run.id }}">{{ run.id[:8] }}…</code></td>
                                <td>
                                    <span class="badge
                                        {% if run.status == 'ok' %}bg-success
                                        {% elseif run.status == 'running' %}bg-warning text-dark
                                        {% else %}bg-danger{% endif %}">
                                        {{ run.status }}
                                    </span>
                                </td>
                                <td>{{ run.debatesGenerated }}</td>
                                <td>{{ run.startedAt|date('m/d H:i') }}</td>
                                <td>
                                    {% if run.finishedAt %}
                                        {{ ((run.finishedAt.timestamp - run.startedAt.timestamp))|abs }}s
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">No runs yet</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
