{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — TDD Admin{% endblock %}

{% block content %}
<h2 class="mb-4">Dashboard</h2>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <p class="card-text display-6">{{ totalUsers }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5 class="card-title">Today's Debates</h5>
                <p class="card-text display-6">{{ todayDebates }}</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card {% if workerConfig.enabled %}text-bg-success{% else %}text-bg-secondary{% endif %}">
            <div class="card-body">
                <h5 class="card-title">Worker Status</h5>
                <p class="card-text">{{ workerConfig.enabled ? 'Enabled' : 'Disabled' }}</p>
                <small>Schedule: {{ workerConfig.schedule }}</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-bg-info">
            <div class="card-body">
                <h5 class="card-title">Target Debates/Day</h5>
                <p class="card-text display-6">{{ workerConfig.targetDebates }}</p>
            </div>
        </div>
    </div>
</div>

<h4>Recent Worker Runs</h4>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Run ID</th>
                <th>Status</th>
                <th>Debates Generated</th>
                <th>Started</th>
                <th>Finished</th>
            </tr>
        </thead>
        <tbody>
            {% for run in recentRuns %}
            <tr>
                <td><code>{{ run.id[:8] }}...</code></td>
                <td>
                    <span class="badge badge-{{ run.status }}">{{ run.status }}</span>
                </td>
                <td>{{ run.debatesGenerated }}</td>
                <td>{{ run.startedAt|date('Y-m-d H:i') }}</td>
                <td>{{ run.finishedAt ? run.finishedAt|date('Y-m-d H:i') : '—' }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted">No runs yet</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a href="/admin/worker" class="btn btn-outline-primary">View Worker Config</a>
</div>
{% endblock %}
