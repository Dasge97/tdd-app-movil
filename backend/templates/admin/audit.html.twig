{% extends 'admin/base.html.twig' %}

{% block title %}Audit Log — TDD Admin{% endblock %}

{% block content %}
<h2 class="mb-4">Audit Log</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Admin</th>
                <th>Action</th>
                <th>Entity Type</th>
                <th>Entity ID</th>
                <th>Payload</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
            <tr>
                <td>{{ log.id }}</td>
                <td><strong>{{ log.adminUser.username }}</strong></td>
                <td><code>{{ log.actionType }}</code></td>
                <td>{{ log.entityType }}</td>
                <td>{{ log.entityId ?? '—' }}</td>
                <td>
                    {% if log.payload %}
                    <button class="btn btn-sm btn-outline-secondary" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#payload-{{ log.id }}">
                        View
                    </button>
                    <div class="collapse mt-1" id="payload-{{ log.id }}">
                        <pre class="bg-light p-2 rounded small">{{ log.payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </div>
                    {% else %}
                    —
                    {% endif %}
                </td>
                <td>{{ log.createdAt|date('Y-m-d H:i:s') }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center text-muted py-3">No audit entries found</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<nav aria-label="Pagination">
    <ul class="pagination">
        {% if page > 1 %}
        <li class="page-item">
            <a class="page-link" href="?page={{ page - 1 }}">Previous</a>
        </li>
        {% endif %}
        <li class="page-item disabled">
            <span class="page-link">Page {{ page }}</span>
        </li>
        <li class="page-item">
            <a class="page-link" href="?page={{ page + 1 }}">Next</a>
        </li>
    </ul>
</nav>
{% endblock %}
